# Copy to .env (PowerShell: Copy-Item .env.example .env). Never commit .env.
# Anything left as PLACEHOLDER/FILL_IN is treated as "not set" and keeps real features disabled.
APP_ENV=development                    # test | development | production
TENANT_ACTIVATED=false                # must be true before ANY real Telegram message is sent
FOLLOWUPS_ENABLED=false                # must be true (plus client feature flag) to run day 1/3/7 follow-ups

TELEGRAM_BOT_TOKEN=PLACEHOLDER
TELEGRAM_BOT_USERNAME=PLACEHOLDER
LLM_PROVIDER=none                      # none | mock (dev only) | anthropic
LLM_API_KEY=PLACEHOLDER                # client's own provider key (needed when LLM_PROVIDER=anthropic)
LLM_MODEL=PLACEHOLDER                  # model id from the provider's docs (verify before use)
FREE_GUIDE_PATH=PLACEHOLDER             # path to the free guide file (PDF)
BOOKING_URL=PLACEHOLDER                # Cal.com / Calendly link
SALES_NOTIFICATION_CHAT_ID=PLACEHOLDER # Telegram chat id of the sales team
DATABASE_URL=PLACEHOLDER               # PostgreSQL, used from Phase 1
# Client-specific text (course name, privacy notice, ...) lives in clients/clientone.yaml, not here.
